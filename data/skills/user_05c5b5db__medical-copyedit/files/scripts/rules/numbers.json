{
  "scope": "national",
  "layer_name": "国家标准（数字用法）",
  "source": "GB/T 15835-2011",
  "auto": true,
  "rules": [
    {"id": "NUM-RANGE", "category": "numbers", "severity": "error", "pattern": "(\\d{1,4}(?:\\.\\d+)?)\\s*-\\s*(\\d{1,4}(?:\\.\\d+)?)", "is_regex": true, "capture": "range", "skip_if_year": true, "skip_context": ["图", "表"], "suggestion": "改为「{left}～{right}」", "message": "数值范围应使用浪纹线「～」而非连字符「-」（命中：{found}）", "example": "30-36", "counter_example": "30～36"},
    {"id": "NUM-PCT", "category": "numbers", "severity": "error", "pattern": "(\\d+)\\s*[~～]\\s*(\\d+)%", "is_regex": true, "capture": "range", "suggestion": "改为「{left}%～{right}%」（两端均带 %）", "message": "百分数范围两端都应带 %（命中：{found}）", "example": "5～10%", "counter_example": "5%～10%"},
    {"id": "NUM-CENTURY", "category": "numbers", "severity": "warning", "pattern": "(十|一|二|三|四|五|六|七|八|九|零|两|〇)+\\s*世纪", "is_regex": true, "suggestion": "改为阿拉伯数字，如「20 世纪 90 年代」", "message": "世纪、年代应使用阿拉伯数字（命中：{found}）", "example": "二十世纪", "counter_example": "20 世纪"},
    {"id": "NUM-YUE", "category": "numbers", "severity": "warning", "pattern": "约\\s*十[几两]", "is_regex": true, "suggestion": "删去「约」或改写法", "message": "「十几」已表概数，前面不必再加「约」（命中：{found}）", "example": "约十几例", "counter_example": "十余例"},
    {"id": "NUM-TIMES", "category": "numbers", "severity": "warning", "pattern": "(减少|降低|下降|缩减).{0,6}倍", "is_regex": true, "suggestion": "改写，勿用「倍」表示降低（用分数或百分数）", "message": "倍数用于表示增加，减少/降低应使用分数或百分数（命中：{found}）", "example": "降低2倍", "counter_example": "降低一半 / 降低 50%"},
    {"id": "NUM-LEADZERO", "category": "numbers", "severity": "warning", "pattern": "(?<!\\d)[.．]\\d", "is_regex": true, "suggestion": "改为「0.x」（小数点用「.」或「．」；句号「。」后接数字非小数）", "message": "纯小数前的零不可省略（命中：{found}）", "example": ".5", "counter_example": "0.5"},
    {"id": "NUM-THOUSAND", "category": "numbers", "severity": "warning", "pattern": "\\d{1,3},\\d{3}(\\.\\d+)?", "is_regex": true, "suggestion": "改为空格分节，如 12 345", "message": "多位数字不使用千分位逗号，应每 3 位空 1/4 汉字（命中：{found}）", "example": "1,234", "counter_example": "1 234"}
  ]
}
