      "prompts": {
        "page_analysis": "prompts/single_page_prompt.txt",
        "chapter_analysis": "prompts/chapter_analysis_prompt.txt",
        "overall_analysis": "prompts/overall_prompt.txt",
        "transcript_analysis": "prompts/transcript_prompt.txt"
      },
      "features": {
        "scoring": true,
        "framework_check": true,
        "deep_analysis": false,
        "root_cause": false,
        "strategy_assessment": false
      }
