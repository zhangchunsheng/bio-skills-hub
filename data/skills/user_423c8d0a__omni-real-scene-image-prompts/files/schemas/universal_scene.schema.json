{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omni-real-scene/universal-scene.schema.json",
  "title": "Universal R12 Scene World Card",
  "type": "object",
  "required": [
    "id",
    "truth_mode",
    "content_objective",
    "platform",
    "aspect_ratio",
    "asset_role",
    "domain",
    "audience",
    "world_context",
    "spatial_logic",
    "subject_identity",
    "key_objects",
    "primary_action",
    "people_relations",
    "camera",
    "lighting_materials",
    "text_strategy",
    "continuity",
    "truth_boundary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "truth_mode": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "content_objective": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "aspect_ratio": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?:[0-9]+(?:\\.[0-9]+)?$"
    },
    "asset_role": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "world_context": {
      "type": "object",
      "minProperties": 1
    },
    "spatial_logic": {
      "type": "object",
      "minProperties": 1
    },
    "subject_identity": {},
    "key_objects": {
      "type": "array",
      "minItems": 1
    },
    "primary_action": {
      "type": "string",
      "minLength": 1
    },
    "people_relations": {},
    "camera": {
      "type": "object",
      "minProperties": 1
    },
    "lighting_materials": {
      "type": "object",
      "minProperties": 1
    },
    "text_strategy": {
      "type": "object",
      "minProperties": 1
    },
    "continuity": {
      "type": "object",
      "minProperties": 1
    },
    "truth_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
