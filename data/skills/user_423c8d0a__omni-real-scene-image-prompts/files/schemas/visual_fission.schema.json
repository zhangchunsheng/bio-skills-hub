{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omni-real-scene/visual-fission.schema.json",
  "title": "V10 Visual Fission Matrix",
  "type": "object",
  "required": [
    "seed",
    "dimensions",
    "candidates"
  ],
  "properties": {
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "object",
      "required": [
        "domain",
        "audience",
        "content_objective",
        "platform",
        "scene_moment",
        "subject",
        "action",
        "emotional_evidence",
        "visual_language",
        "delivery_variant"
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
