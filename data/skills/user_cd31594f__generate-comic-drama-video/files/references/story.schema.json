{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/generate-comic-drama-video/story.schema.json",
  "title": "Comic drama story plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "project",
    "visual_style",
    "narrator",
    "characters",
    "audio",
    "approvals",
    "scenes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "stage": {
      "enum": [
        "story_review",
        "visual_review",
        "style_and_character_review",
        "scene_image_review",
        "audio_generation",
        "composition",
        "complete"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "theme",
        "language",
        "width",
        "height",
        "fps",
        "max_duration_seconds",
        "max_scenes",
        "image_size"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "width": { "const": 1920 },
        "height": { "const": 1080 },
        "fps": { "const": 30 },
        "max_duration_seconds": { "const": 900 },
        "max_scenes": { "const": 600 },
        "caption_max_characters": {
          "type": "integer",
          "minimum": 8,
          "maximum": 80,
          "default": 24
        },
        "image_size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*x[1-9][0-9]*$",
          "default": "2048x1152"
        }
      }
    },
    "visual_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "style_prompt",
        "composition_prompt",
        "palette_prompt",
        "avoid"
      ],
      "properties": {
        "mode": { "enum": ["user_reference", "generated_anchor"] },
        "reference_image": { "type": ["string", "null"] },
        "anchor_prompt": { "type": ["string", "null"] },
        "style_prompt": { "type": "string", "minLength": 1 },
        "composition_prompt": { "type": "string", "minLength": 1 },
        "palette_prompt": { "type": "string", "minLength": 1 },
        "avoid": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "user_reference" } } },
          "then": { "required": ["reference_image"] }
        },
        {
          "if": { "properties": { "mode": { "const": "generated_anchor" } } },
          "then": { "required": ["anchor_prompt"] }
        }
      ]
    },
    "narrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "tone", "speed", "language"],
      "properties": {
        "provider": { "enum": ["local_kokoro", "xiaomi_mimo"] },
        "model": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 },
        "voice_design": { "type": "string", "minLength": 1 },
        "tone": { "type": "string", "minLength": 1 },
        "speed": { "type": "number", "minimum": 0.7, "maximum": 2.0 },
        "language": { "type": "string", "minLength": 2 }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "xiaomi_mimo" } } },
          "then": { "required": ["model"] }
        },
        {
          "if": { "properties": { "model": { "const": "mimo-v2.5-tts-voicedesign" } } },
          "then": { "required": ["voice_design"] }
        }
      ]
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "appearance", "wardrobe", "personality", "sheet_prompt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "appearance": { "type": "string", "minLength": 1 },
          "wardrobe": { "type": "string", "minLength": 1 },
          "personality": { "type": "string", "minLength": 1 },
          "sheet_prompt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sfx_enabled", "sentence_gap_seconds", "bgm"],
      "properties": {
        "sfx_enabled": { "const": false },
        "sentence_gap_seconds": { "type": "number", "minimum": 0, "maximum": 2 },
        "scene_gap_seconds": { "type": "number", "minimum": 0, "maximum": 2 },
        "bgm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "const": "local_musicgen" },
            "prompts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": { "type": "string", "minLength": 1 }
            },
            "volume": { "type": "number", "minimum": 0.01, "maximum": 0.35 },
            "model": { "type": "string", "default": "facebook/musicgen-small" },
            "seed_seconds": { "type": "number", "minimum": 5, "maximum": 30, "default": 20 }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } } },
              "then": { "required": ["mode", "prompts", "volume"] }
            }
          ]
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["story", "style_and_characters", "scene_images"],
      "properties": {
        "story": { "enum": ["pending", "approved", "rejected"] },
        "style_and_characters": { "enum": ["pending", "approved", "rejected"] },
        "scene_images": { "enum": ["pending", "approved", "rejected"] }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "image_prompt",
          "character_ids",
          "narrations",
          "focus",
          "motion"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^scene_[0-9]{3,4}$" },
          "name": { "type": "string", "minLength": 1 },
          "image_prompt": { "type": "string", "minLength": 1 },
          "character_ids": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "narrations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "emotion"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 80 },
                "emotion": { "type": "string", "minLength": 1 }
              }
            }
          },
          "focus": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x_percent", "y_percent"],
            "properties": {
              "x_percent": { "type": "number", "minimum": 0, "maximum": 100 },
              "y_percent": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "motion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "scale_from", "scale_to"],
            "properties": {
              "type": { "enum": ["slow_zoom_in", "slow_zoom_out"] },
              "scale_from": { "type": "number", "minimum": 1, "maximum": 1.2 },
              "scale_to": { "type": "number", "minimum": 1, "maximum": 1.2 }
            }
          }
        }
      }
    }
  }
}
