      ]
    },
    {
      "id": "e7",
      "source": "counting",
      "target": "interpretation_check",
      "label": "",
      "branch": "next",
      "evidence_refs": [
        "fda_alk_label"
      ]
    },
    {
      "id": "e8",
      "source": "interpretation_check",
      "target": "pass",
      "label": "是",
      "branch": "yes",
      "evidence_refs": [
        "fda_alk_label"
      ]
    },
    {
      "id": "e9",
      "source": "interpretation_check",
