{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/skills/molecular-pathology-qc-flow/qc-flow.schema.json",
  "title": "分子病理质控流程定义",
  "description": "用于查询、校验和生成 Draw.io 的分子病理质控流程数据契约。",
  "type": "object",
  "required": [
    "schema_version",
    "diagram",
    "measurements",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.1"
    },
    "diagram": {
      "$ref": "#/$defs/diagram"
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "version",
        "last_verified",
        "scope_note",
        "evidence_status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "enum": [
            "user-file",
            "laboratory-sop",
            "validation-report",
            "manufacturer-ifu",
            "regulatory",
            "professional-guideline",
            "public-database",
            "official-technical-document",
            "user-confirmed"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string"
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string"
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "confirmed",
            "inferred",
            "unknown",
            "conflict"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "path"
          ]
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "flow",
            "swimlane"
          ],
          "default": "flow"
        },
        "page_width": {
          "type": "number",
          "minimum": 400
        },
        "page_height": {
          "type": "number",
          "minimum": 400
        },
        "auto_size": {
          "type": "boolean",
          "default": true
        },
        "show_source_note": {
          "type": "boolean",
          "default": true
        },
        "center_x": {
          "type": "number"
        },
        "start_y": {
          "type": "number"
        },
        "level_gap": {
          "type": "number",
          "minimum": 80
        },
        "lane_gap": {
          "type": "number",
          "minimum": 120
        },
        "stage_gap": {
          "type": "number",
          "minimum": 10
        },
        "margin": {
          "type": "number",
          "minimum": 20
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": [
        "name",
        "id",
        "technology",
        "method",
        "project",
        "qc_stage",
        "stages",
        "sources",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "technology": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "qc_stage": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        }
      }
    },
    "measurement": {
      "type": "object",
      "required": [
        "id",
        "name",
        "unit",
        "description",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": [
        "operator",
        "expression",
        "missing_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "measurement": {
          "$ref": "#/$defs/identifier"
        },
        "operator": {
          "type": "string",
          "enum": [
            "EQ",
            "NE",
            "LT",
            "LE",
            "GT",
            "GE",
            "BETWEEN_CLOSED",
            "BETWEEN_OPEN",
            "IN",
            "EXISTS",
            "MISSING",
            "CUSTOM"
          ]
        },
        "value": {},
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "missing_policy": {
          "type": "string",
          "enum": [
            "fail",
            "pass",
            "invalid",
            "next_branch",
            "manual_review",
            "not_applicable"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "stage",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "type": "string",
          "enum": [
            "start",
            "process",
            "decision",
            "positive",
            "pass",
            "negative",
            "invalid",
            "warning",
            "end"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "terminal_result": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "pass",
            "invalid",
            "manual_review",
            "end"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "lane": {
          "type": "integer"
        },
        "style": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "decision"
              }
            }
          },
          "then": {
            "required": [
              "condition"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "positive",
                  "pass",
                  "negative",
                  "invalid",
                  "end"
                ]
              }
            }
          },
          "then": {
            "required": [
              "terminal_result"
            ]
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "label",
        "branch",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string"
        },
        "branch": {
          "type": "string",
          "enum": [
            "next",
            "yes",
            "no",
            "pass",
            "fail",
            "positive",
            "negative",
            "invalid",
            "manual_review",
            "repeat"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "style": {
          "type": "string"
        }
      }
    }
  }
}
