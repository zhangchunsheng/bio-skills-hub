{
  "name": "bio-skills-hub",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "php -S localhost:8000 php-server/public/index.php",
    "dev:web": "vite",
    "sync": "php php-server/bin/sync.php",
    "build": "vite build",
    "preview": "vite preview",
    "start": "php -S 0.0.0.0:8000 php-server/public/index.php"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
