{
  "name": "bio-skills-hub",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web,admin -c blue,green,magenta \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:admin\"",
    "dev:api": "php server/artisan serve --port=8000",
    "dev:web": "npm --prefix web run dev",
    "dev:admin": "npm --prefix admin run dev",
    "sync": "php server/artisan skills:sync",
    "build": "npm --prefix web run build && npm --prefix admin run build",
    "deploy": "npm run build && bash deploy/deploy.sh",
    "start": "php server/artisan serve --host 0.0.0.0 --port=8000"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
